# Optional Gemini configuration for the Vercel deployment.
#
# IMPORTANT: do NOT put a real key in this file and do NOT commit it.
# Instead, set these in the Vercel dashboard:
#   Project -> Settings -> Environment Variables
#   GEMINI_API_KEY = <your key>
#   GEMINI_MODEL   = gemini-3.1-flash-lite   (optional, this is the default)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
